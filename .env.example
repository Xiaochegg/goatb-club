# ============================================================
# GOATB 环境变量模板（无密钥）
# 复制为 .env 后按需填写；.env 含真实值，已被 .gitignore 排除，严禁提交。
# ============================================================

# SQLite 数据库连接（相对路径按项目根解析；运行时由 src/lib/db.ts 兜底重解析）
# 本地默认即此值，无需改动。
DATABASE_URL=file:./db/custom.db

# 玩家认领功能开关：值 "on" 开启，其余/缺省为 OFF（默认关闭）。
# 也可不设本变量，改在管理面板写 Config 表 key=feature_claim value=on。
# 留空 = 关闭。
FEATURE_CLAIM=

# 网易云音乐 API Cookie（可选，NEXT_PUBLIC_ 前缀会注入浏览器端）。
# 用于提高音乐搜索/取流成功率；留空时走无 Cookie 的公共链路（有降级链）。
NEXT_PUBLIC_NCM_COOKIE=

# ============================================================
# UNIFIED ACCOUNT V1 · Brevo Free 事务邮件（P1，$0/月；2026-11-10 工单）
# 三个变量【全部配置】邮件功能才启用；任一缺省 = NOT_CONFIGURED（绝不假装发送，
# 注册/登录不受影响，用户可在「我的」面板看到「邮件服务尚未配置」提示）。
# 凭证纪律：真实值只进 .env（gitignore 已排除），绝不入代码/日志/报告。
# ============================================================
# Brevo API key（控制台 SMTP & API 页生成；与 SMTP key 是两把不同的钥匙，此处用 API key）
BREVO_API_KEY=
# 已在 Brevo 控制台完成验证的发件人邮箱（建议管理员专用邮箱；未验证域名时邮件可能进垃圾箱）
BREVO_FROM_EMAIL=
# 发件人显示名（缺省 GOATB CLUB）
BREVO_FROM_NAME=GOATB CLUB
# 邮件内验证/重置链接的站点绝对地址（如 https://goatb.example.com）；
# 留空时自动按请求头推导（反代/多域名部署建议显式配置）
MAIL_LINK_ORIGIN=
